###==== BEGIN Clocks
create_clock -name {ddr_ref_clk} [get_ports {sys_clk}] -period {40.000} -waveform {0.000 20.000}
###==== END Clocks

###==== BEGIN "Generated Clocks"
# PLL_CLK.idf requests 10 MHz from the shared 25 MHz sys_clk. Constrain the
# actual GPLL output explicitly instead of relying on SDC-2025 inference.
create_generated_clock -name {hdmi_cfg_clk} -source [get_ports {sys_clk}] [get_pins {u_hdmi_in_demo.u_PLL_CLK.u_gpll/CLKOUT0}] -master_clock [get_clocks {ddr_ref_clk}] -multiply_by {2} -divide_by {5}
create_generated_clock -name {rst_clk} -source [get_ports {sys_clk}] [get_pins {g_ddr_frame_buffer.u_ddr_frame_buffer.u_ddr_user_port.I_ips_ddr_top.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {ddr_ref_clk}] -multiply_by {84} -divide_by {84}
create_generated_clock -name {ddrphy_sysclk} -source [get_ports {sys_clk}] [get_pins {g_ddr_frame_buffer.u_ddr_frame_buffer.u_ddr_user_port.I_ips_ddr_top.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {ddr_ref_clk}] -multiply_by {84} -divide_by {16}
create_generated_clock -name {phy_dq_clk_0} -source [get_ports {sys_clk}] [get_pins {g_ddr_frame_buffer.u_ddr_frame_buffer.u_ddr_user_port.I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ddr_ref_clk}] -multiply_by {84} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {g_ddr_frame_buffer.u_ddr_frame_buffer.u_ddr_user_port.I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {g_ddr_frame_buffer.u_ddr_frame_buffer.u_ddr_user_port.I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]
create_generated_clock -name {phy_dq_clk_1} -source [get_ports {sys_clk}] [get_pins {g_ddr_frame_buffer.u_ddr_frame_buffer.u_ddr_user_port.I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ddr_ref_clk}] -multiply_by {84} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {g_ddr_frame_buffer.u_ddr_frame_buffer.u_ddr_user_port.I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {g_ddr_frame_buffer.u_ddr_frame_buffer.u_ddr_user_port.I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_groups -name ddr_ref_clk -asynchronous -group [get_clocks {ddr_ref_clk}]
set_clock_groups -name rst_clk -asynchronous -group [get_clocks {rst_clk}]
set_clock_groups -name phy_dq_clk_0 -asynchronous -group [get_clocks {phy_dq_clk_0}]
set_clock_groups -name phy_dq_clk_1 -asynchronous -group [get_clocks {phy_dq_clk_1}]
# HDMI init/ready are level CDC signals into pixclk_in and are synchronized
# in pcie_dma_test.  Keep the independent clock domains separate; this is a
# targeted CDC constraint, not a waiver for pixclk data paths.
# HDMI/config/DDR data CDCs are bounded individually below. PDS 2022.2-SP6.4
# ignores -allow_paths, so do not apply a broad asynchronous cut to these.
###==== END "Generated Clocks"

