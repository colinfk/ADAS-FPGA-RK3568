# sys_clk is shared with the existing HDMI project constraint. The old
# generated device map already records V4 as 1.5V/LVCMOS15; keep the single
# board-level declaration in hdmi_loop_v1.1.fdc.

###==== END Io Table


# v5 CDC bounds: PDS UCE UG sections 2.2.3/2.2.4.
# RTL vectors are represented as [MSB:LSB] cells before synthesis, then bits.
# Match both forms. Gray paths have a 5 ns total datapath budget; all
# non-negative bit delays below this bound also have <5 ns relative spread,
# below the shortest supported source period (6.670 ns). Bound held data at 6 ns.
# Preserve CDC datapath analysis without broad clock-group cuts. Cut only the
# asynchronous single-bit first stages; their second stages remain timed.
set_false_path -to [get_cells -hierarchical -regexp {.*snapshot/(req_sync1|ack_sync1).*}]
set_false_path -to [get_cells -hierarchical -regexp {.*u_video_frame_bridge/(run_sync1|idle_sync1).*}]
set_false_path -to [get_cells -hierarchical -regexp {.*u_ddr_frame_buffer/fifo_writer_priority_sync1.*}]
set_false_path -to [get_cells -hierarchical -regexp {.*u_rx_monitor/(raw_d1|events_d1|hs_seen_d1).*}]
set_false_path -to [get_cells -hierarchical -regexp {.*u_timing_monitor/vs_sync1.*}]
# Runtime sample-edge choice is a stable cfg-domain bit with two pixel-domain
# synchronizers. Only stage 1 is asynchronous; stage 2 and the RGB mux stay timed.
set_false_path -to [get_cells -hierarchical -regexp {.*u_input_sampler/select_sync1.*}]
set_false_path -to [get_pins -hierarchical -regexp {.*u_timing_monitor/pix_reset.*/C$}]
set_false_path -to [get_cells -hierarchical -regexp {(hdmi_flags_d1|ddr_extra_d1|ddr_diag_flags_d1|ddr_.*_pclk_d1).*}]
# Reset assertion enters local reset synchronizers asynchronously. PDS's
# pre-synthesis bmsWIDEDFFCPE clear pin is C. Cut only those clear pins;
# stage-to-stage D paths and functional recovery/removal remain analyzed.
set_false_path -to [get_pins -hierarchical -regexp {.*(snapshot/(src_reset_pipe|dst_reset_pipe)|u_video_frame_bridge/(pcie_reset_pipe|ddr_reset_pipe)|u_ddr_frame_buffer/fifo_(pix|ddr)_reset|u_ips2l_pcie_dma_rx_top/video_(wr|rd)_reset_pipe|u_rx_monitor/pix_reset_pipe).*/C$}]
# Existing board-level capture reset and receiver-ready bridges use the
# vendor rs1/rs2 release synchronizer. Their asynchronous C inputs need the
# same exception; the counter and rstn_out paths remain checked.
set_false_path -to [get_pins -hierarchical -regexp {u_hdmi_pix_(rst|ready)_sync/rs[12]/C$}]
# The async distributed FIFO holds each written RAM entry until its read
# pointer returns through two synchronizers. Its write-clock-to-read-data
# arc has no synchronous phase relationship. Cut that RAM arc only; retain
# the PCIe read-address-to-data timing and all Gray-pointer bounds below.
set_false_path -from [get_cells -hierarchical -regexp {.*u_video_write_fifo/pgm_distributed_sdpram/.*}] -to [get_clocks {pclk_div2}]
# Clock startpoints cover any source Gray MSB merged into an equivalent
# binary register by synthesis, while the destination selects only stage 1.
set_max_delay 5.0 -datapath_only -from [get_clocks {pix_clk_in}] -to [get_cells -hierarchical -regexp {.*u_hdmi_ddr_fifo/wr_gray_rd_d1\[[0-9:]+\].*}]
set_max_delay 5.0 -datapath_only -from [get_clocks {ddrphy_sysclk}] -to [get_cells -hierarchical -regexp {.*u_hdmi_ddr_fifo/rd_gray_wr_d1\[[0-9:]+\].*}]
set_max_delay 5.0 -datapath_only -from [get_clocks {ddrphy_sysclk}] -to [get_cells -hierarchical -regexp {.*u_video_write_fifo.*/ASYN_CTRL.rwptr1\[[0-9:]+\].*}]
set_max_delay 5.0 -datapath_only -from [get_clocks {pclk_div2}] -to [get_cells -hierarchical -regexp {.*u_video_write_fifo.*/ASYN_CTRL.wrptr1\[[0-9:]+\].*}]
set_max_delay 6.0 -datapath_only -from [get_cells -hierarchical -regexp {.*snapshot/held_data\[[0-9:]+\].*}] -to [get_cells -hierarchical -regexp {.*snapshot/dst_data\[[0-9:]+\].*}]

# Tiny CNN bundles remain bounded; only synchronizer first stages are false paths.
set_false_path -to [get_cells -hierarchical -regexp {.*u_lane_cnn/buffers/(req_meta|ack_meta).*}]
set_false_path -to [get_cells -hierarchical -regexp {.*u_lane_cnn/result_cdc/(req_sync1|ack_sync1).*}]
set_false_path -to [get_pins -hierarchical -regexp {.*u_lane_cnn/(vr|cr|pr|result_cdc/(src_reset_pipe|dst_reset_pipe)).*/C$}]
set_max_delay 6.0 -datapath_only -from [get_cells -hierarchical -regexp {.*u_lane_cnn/result_cdc/held_data.*}] -to [get_cells -hierarchical -regexp {.*u_lane_cnn/result_cdc/dst_data.*}]
set_max_delay 6.0 -datapath_only -from [get_cells -hierarchical -regexp {.*u_lane_cnn/buffers/(ids|drops).*}] -to [get_cells -hierarchical -regexp {.*u_lane_cnn/scheduler/(frame_id|drop_count).*}]

# User-key CDC: only first-stage synchronizers are asynchronous.
set_false_path -to [get_cells -hierarchical -regexp {.*u_lane_keys/key_meta.*}]
set_false_path -to [get_cells -hierarchical -regexp {.*u_lane_keys/u_key_snapshot/(req_sync1|ack_sync1).*}]
set_max_delay 6.0 -datapath_only -from [get_cells -hierarchical -regexp {.*u_lane_keys/u_key_snapshot/held_data.*}] -to [get_cells -hierarchical -regexp {.*u_lane_keys/u_key_snapshot/dst_data.*}]
