#使用V1.0版本的HDMI子卡，需要加上第19、174、183行约束
#使用V1.1版本的HDMI子卡，可以删掉19、174、183行约束，然后将pixclk_in的引脚改为W19，b_in[1]的引脚改为w20

# RGB 1080p30 EDID requests 74.25 MHz (74.176 MHz at 29.97 Hz).
# 13 ns also covers the mode monitor's +3% measurement tolerance. The
# datasheet permits 40-60% duty: reserve 10% of T for opposite-edge paths.
# External min/max delays still require the actual board phase/skew envelope.
create_clock -name {pix_clk_in} [get_ports {pixclk_in}] -period {13.000} -waveform {0.000 6.500}
set_clock_uncertainty -setup 1.300 [get_clocks {pix_clk_in}]

# sys_clk
define_attribute {p:sys_clk} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:sys_clk} {PAP_IO_LOC} {V4}
define_attribute {p:sys_clk} {PAP_IO_VCCIO} {1.5}
define_attribute {p:sys_clk} {PAP_IO_STANDARD} {LVCMOS15}
define_attribute {p:sys_clk} {PAP_IO_UNUSED} {TRUE}

# pixclk_in
define_attribute {p:pixclk_in} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:pixclk_in} {PAP_IO_LOC} {W19}
define_attribute {p:pixclk_in} {PAP_IO_VCCIO} {3.3}
define_attribute {p:pixclk_in} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:pixclk_in} {PAP_IO_NONE} {TRUE}

